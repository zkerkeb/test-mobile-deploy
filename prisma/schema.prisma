generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MealIdea {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  maxMinutes  Int
  budget      String
  authorName  String?
  likes       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([budget])
  @@index([maxMinutes])
}
